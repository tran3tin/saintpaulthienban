# Frontend Environment Variables - Development

# ===========================================
# API Configuration (Required)
# ===========================================

# Local development - connect to backend on localhost
VITE_API_URL=http://localhost:5000/api

# Optional: API timeout (default: 30000ms)
VITE_API_TIMEOUT=30000

# ===========================================
# For Production Deployment
# ===========================================
# Copy this file to .env.production and update VITE_API_URL
# to your backend URL on Render:
# VITE_API_URL=https://your-backend.onrender.com/api
