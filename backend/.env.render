# Environment variables for Production Deployment

# ===========================================
# DATABASE - SUPABASE (Required)
# ===========================================
# Get this from Supabase: Project Settings > Database > Connection String (URI)
# Format: postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ===========================================
# NODE ENVIRONMENT (Required)
# ===========================================
NODE_ENV=production

# ===========================================
# JWT CONFIGURATION (Required)
# ===========================================
# Generate a strong random string (min 32 chars):
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# ===========================================
# CORS CONFIGURATION (Required)
# ===========================================
# Your frontend URL on Render (no trailing slash)
# Example: https://saintpaulthienban.onrender.com
CORS_ORIGIN=

# ===========================================
# PORT (Optional - Render sets this automatically)
# ===========================================
# PORT=10000

# ===========================================
# UPLOAD CONFIGURATION (Optional)
# ===========================================
MAX_FILE_SIZE=10485760
