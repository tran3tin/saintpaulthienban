# Server Config
PORT=5000
NODE_ENV=development

# Database Config
# Option 1: Use DATABASE_URL (recommended for Supabase/Render)
# Get this from Supabase Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Option 2: Individual connection parameters (fallback)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=hr_records

# JWT Config
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Upload Config
MAX_FILE_SIZE=10485760

# CORS Config (comma-separated for multiple origins)
# Development:
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Production (replace with your actual Render frontend URL):
# CORS_ORIGIN=https://saintpaulthienban.onrender.com,http://localhost:3000

# Copy this file to .env and replace placeholders with actual deployment values.
